{
  "name": "calm-design-workflow",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:site": "node scripts/prepare-site.mjs",
    "predev": "npm run prepare:site",
    "dev": "next dev --webpack",
    "prebuild": "npm run prepare:site",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app scripts tests playwright.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": { "next": "16.3.5", "react": "19.2.4", "react-dom": "19.2.4" },
  "devDependencies": { "@playwright/test": "^1.58.0", "@tailwindcss/postcss": "^4", "@types/node": "^22", "@types/react": "^19", "@types/react-dom": "^19", "eslint": "^9", "eslint-config-next": "16.3.5", "tailwindcss": "^4", "typescript": "^5" }
}
